{
  "name": "@local/dsh-restart",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "version": "0.1.0",
  "description": "Reload plugins or gracefully restart DeepSeek Harness (DSH) from the sidebar More menu",
  "license": "MIT",
  "private": true,
  "main": "./index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wellsoren/dsh-restart.git"
  },
  "homepage": "https://github.com/wellsoren/dsh-restart#readme",
  "bugs": {
    "url": "https://github.com/wellsoren/dsh-restart/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "restart",
    "reload",
    "systemd"
  ],
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "LICENSE",
    "restart-location.png",
    "screenshots.json"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.5 <0.3.0-0"
  }
}
